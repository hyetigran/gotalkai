{
  "name": "voice-service",
  "version": "0.1.0",
  "private": true,
  "description": "Long-lived realtime voice pipeline service. See /ARCHITECTURE.md §3.3.",
  "packageManager": "pnpm@10.12.3",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node --env-file=.env dist/index.js",
    "dev": "node --env-file=.env --import tsx --watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "lint": "eslint .",
    "debug:persona-turn": "node --env-file=.env --import tsx src/debug-persona-turn.ts",
    "eval": "node --env-file=.env --import tsx src/eval/run-eval.ts",
    "eval:golden-set-append-only": "tsx src/eval/append-only.ts",
    "eval:canary": "node --env-file=.env --import tsx src/eval/run-canary.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@elevenlabs/elevenlabs-js": "^2.59.0",
    "ws": "^8.18.0",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.2",
    "@types/ws": "^8.5.13",
    "eslint": "^9.39.2",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.19.0"
  }
}
