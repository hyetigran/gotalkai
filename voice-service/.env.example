# Railway injects PORT automatically; this default is for local dev only.
PORT=8080
NODE_ENV=development

# Shared-secret bearer token clients must present to open a connection.
# Placeholder until the app service exists to issue real per-session
# credentials (ARCHITECTURE.md §6). Minimum 16 characters.
VOICE_SERVICE_AUTH_TOKEN=

# Ticket #14: the persona LLM stage (ADR-0003: Claude Sonnet 5) needs a
# real key to call the Anthropic API. Required — no default.
ANTHROPIC_API_KEY=

# Ticket #15/#17: ElevenLabs for both STT and TTS (docs/adr/0013 —
# deadline-driven, bake-off skipped). Required — no default.
ELEVENLABS_API_KEY=

# Ticket #17: the ElevenLabs voice ID for Валентина. No default —
# nobody has listened to and picked a real voice from ElevenLabs'
# library in this environment (docs/adr/0016). Required.
ELEVENLABS_VALENTINA_VOICE_ID=
