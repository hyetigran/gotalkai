
# This hook lives in mobile/.husky but git invokes it from the repo root
# (mobile/ is a subdirectory of this repo, not the git root itself) —
# pnpm needs to run where mobile/package.json actually is.
cd "$(dirname "$0")/.." || exit 1

function changed {
    git diff --name-only HEAD@{1} HEAD | grep "^mobile/$1" >/dev/null 2>&1
}

echo 'Checking for changes in pnpm-lock.yml...'

if changed 'pnpm-lock.yml'; then
    echo "📦 pnpm-lock.yml changed. Run pnpm install to bring your dependencies up to date."
    pnpm install
fi

echo 'You are up to date :)'

echo 'If necessary, you can run pnpm prebuild to generate native code.'

exit 0
