# Railway injects PORT automatically; this default is for local dev only.
PORT=8081
NODE_ENV=development

# Standard postgres:// connection string — Railway's own Postgres addon
# env var name. For local dev, create a database first (see README.md).
DATABASE_URL=postgres://localhost:5432/lingoai_app_service

# Signs short-lived, session-scoped voice-service credentials minted by
# POST /sessions. Must be the exact same value as voice-service's own
# SESSION_TOKEN_SECRET (see voice-service/.env.example) — both services
# verify tokens against this shared secret. Never sent to the mobile
# client. Minimum 32 characters. Generate one with e.g.
# `openssl rand -base64 32`.
SESSION_TOKEN_SECRET=
