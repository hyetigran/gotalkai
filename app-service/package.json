{
  "name": "app-service",
  "version": "0.1.0",
  "private": true,
  "description": "Long-lived service owning auth, persistence, memory, and debrief analysis. See /ARCHITECTURE.md §3.2 and §3.5 (migrations/).",
  "packageManager": "pnpm@10.12.3",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node --env-file=.env dist/main.js",
    "dev": "node --env-file=.env --import tsx --watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "lint": "eslint .",
    "db:migrate": "node --env-file=.env --import tsx src/db/migrate.ts",
    "observability:run-checks": "node --env-file=.env --import tsx src/observability/run-checks.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "pg": "^8.13.1",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "eslint": "^9.39.2",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.19.0"
  }
}
